//@version=6
indicator("BP", overlay = true)

// --- Crossing Flags Shown ---
flag1T = input.bool(defval = false, title  = "Display 1T/5T Crossing Flag")
flag5T = input.bool(defval = true, title  = "Display 5T/HT Crossing Flag")
flagHT = input.bool(defval = true, title  = "Display HT/DT Crossing Flag")
flagDT = input.bool(defval = true, title  = "Display DT/WT Crossing Flag")

// --- Session Display Input ---
sessionDisplay = input.string(
     title   = "Session Display",
     defval  = "Both",
     options = ["Chart Default", "Regular Only", "Extended Only", "Both"]
     )

// --- Helper Flags ---
showRegular  = sessionDisplay == "Both" or sessionDisplay == "Regular Only" or (sessionDisplay == "Chart Default" and syminfo.session == session.regular)
showExtended = sessionDisplay == "Both" or sessionDisplay == "Extended Only" or (sessionDisplay == "Chart Default" and syminfo.session != session.regular)
showBoth     = showRegular and showExtended

// --- Multi-Timeframe EMA Calculations on Regular session ---
tickerRegular = ticker.modify(syminfo.tickerid, session=session.regular)
regularEMA1T = request.security(tickerRegular, "1",  ta.ema(close, 27), lookahead = barmerge.lookahead_on)
regularEMA5T = request.security(tickerRegular, "5",  ta.ema(close, 27), lookahead = barmerge.lookahead_on)
regularEMAHT = request.security(tickerRegular, "60", ta.ema(close, 27), lookahead = barmerge.lookahead_on)
regularEMADT = request.security(tickerRegular, "D",  ta.ema(close, 27), lookahead = barmerge.lookahead_on)
regularEMAWT = request.security(tickerRegular, "W",  ta.ema(close, 27), lookahead = barmerge.lookahead_on)
regularEMAMT = request.security(tickerRegular, "M",  ta.ema(close, 27), lookahead = barmerge.lookahead_on)

// --- Multi-Timeframe EMA Calculations on Extended session ---
tickerExtended = ticker.modify(syminfo.tickerid, session="24h")
extendedEMA1T = request.security(tickerExtended, "1",  ta.ema(close, 27), lookahead = barmerge.lookahead_on)
extendedEMA5T = request.security(tickerExtended, "5",  ta.ema(close, 27), lookahead = barmerge.lookahead_on)
extendedEMAHT = request.security(tickerExtended, "60", ta.ema(close, 27), lookahead = barmerge.lookahead_on)
extendedEMADT = request.security(tickerExtended, "D",  ta.ema(close, 27), lookahead = barmerge.lookahead_on)
extendedEMAWT = request.security(tickerExtended, "W",  ta.ema(close, 27), lookahead = barmerge.lookahead_on)
extendedEMAMT = request.security(tickerExtended, "M",  ta.ema(close, 27), lookahead = barmerge.lookahead_on)

// --- Colors ---
c1T = color.rgb(220, 178, 59)
c5T = color.rgb(52, 114, 171)
cHT = color.rgb(162, 72, 255)
cDT = color.rgb(49, 27, 146)
cWT = color.rgb(14, 179, 91)
cMT = color.rgb(248, 121, 89)
tRegular = 0
tExtended = 30
tFaded = 80

// --- Plotting Regular Session EMAs ---
pReg1T = plot(showRegular ? regularEMA1T : na, title = "1Tr", color = color.new(c1T, tRegular), linewidth=3, force_overlay = true)
pReg5T = plot(showRegular ? regularEMA5T : na, title = "5Tr", color = color.new(c5T, tRegular), linewidth=3, force_overlay = true)
pRegHT = plot(showRegular ? regularEMAHT : na, title = "HTr", color = color.new(cHT, tRegular), linewidth=3, force_overlay = true)
pRegDT = plot(showRegular ? regularEMADT : na, title = "DTr", color = color.new(cDT, tRegular), linewidth=3, force_overlay = true)
pRegWT = plot(showRegular ? regularEMAWT : na, title = "WTr", color = color.new(cWT, tRegular), linewidth=3, force_overlay = true)
pRegMT = plot(showRegular ? regularEMAMT : na, title = "MTr", color = color.new(cMT, tRegular), linewidth=3, force_overlay = true)

// --- Plotting Extended Session EMAs ---
pExt1T = plot(showExtended ? extendedEMA1T : na, title = "1Te", color = color.new(c1T, tExtended), linewidth=2, force_overlay = true)
pExt5T = plot(showExtended ? extendedEMA5T : na, title = "5Te", color = color.new(c5T, tExtended), linewidth=2, force_overlay = true)
pExtHT = plot(showExtended ? extendedEMAHT : na, title = "HTe", color = color.new(cHT, tExtended), linewidth=2, force_overlay = true)
pExtDT = plot(showExtended ? extendedEMADT : na, title = "DTe", color = color.new(cDT, tExtended), linewidth=2, force_overlay = true)
pExtWT = plot(showExtended ? extendedEMAWT : na, title = "WTe", color = color.new(cWT, tExtended), linewidth=2, force_overlay = true)
pExtMT = plot(showExtended ? extendedEMAMT : na, title = "MTe", color = color.new(cMT, tExtended), linewidth=2, force_overlay = true)

// --- Gradient Fills Between Regular and Extended Lines ---
fill(pReg1T, pExt1T, color.new(c1T, tFaded), title = "1T Session Gradient")
fill(pReg5T, pExt5T, color.new(c5T, tFaded),  title = "5T Session Gradient")
fill(pRegHT, pExtHT, color.new(cHT, tFaded), title = "HT Session Gradient")

// --- Plotting Crossover Markers ---
crossReg1T_5T_up = ta.crossover(regularEMA1T, regularEMA5T)
crossReg1T_5T_dn = ta.crossunder(regularEMA1T, regularEMA5T)
crossReg5T_HT_up = ta.crossover(regularEMA5T, regularEMAHT)
crossReg5T_HT_dn = ta.crossunder(regularEMA5T, regularEMAHT)
crossRegHT_DT_up = ta.crossover(regularEMAHT, regularEMADT)
crossRegHT_DT_dn = ta.crossunder(regularEMAHT, regularEMADT)
crossRegDT_WT_up = ta.crossover(regularEMADT, regularEMAWT)
crossRegDT_WT_dn = ta.crossunder(regularEMADT, regularEMAWT)
plotshape(
     series      = flag1T and crossReg1T_5T_up ? regularEMA5T : na, 
     title       = "5T/HT Bull Cross Marker", 
     style       = shape.triangleup, 
     location    = location.bottom, 
     color       = c1T, 
     size        = size.small, 
     force_overlay = true
     )
plotshape(
     series      = flag1T and crossReg1T_5T_dn ? regularEMA5T : na, 
     title       = "5T/HT Bear Cross Marker", 
     style       = shape.triangledown, 
     location    = location.bottom, 
     color       = c1T, 
     size        = size.small, 
     force_overlay = true
     )
plotshape(
     series      = flag5T and crossReg5T_HT_up ? regularEMAHT : na, 
     title       = "5T/HT Bull Cross Marker", 
     style       = shape.triangleup, 
     location    = location.bottom, 
     color       = c5T, 
     size        = size.small, 
     force_overlay = true
     )
plotshape(
     series      = flag5T and crossReg5T_HT_dn ? regularEMAHT : na, 
     title       = "5T/HT Bear Cross Marker", 
     style       = shape.triangledown, 
     location    = location.bottom, 
     color       = c5T, 
     size        = size.small, 
     force_overlay = true
     )
plotshape(
     series      = flagHT and crossRegHT_DT_up ? regularEMADT : na, 
     title       = "HT/DT Bull Cross Marker", 
     style       = shape.triangleup, 
     location    = location.bottom, 
     color       = cHT, 
     size        = size.small, 
     force_overlay = true
     )
plotshape(
     series      = flagHT and crossRegHT_DT_dn ? regularEMADT : na, 
     title       = "HT/DT Bear Cross Marker", 
     style       = shape.triangledown, 
     location    = location.bottom, 
     color       = cHT, 
     size        = size.small, 
     force_overlay = true
     )
plotshape(
     series      = flagDT and crossRegDT_WT_up ? regularEMAWT : na, 
     title       = "DT/WT Bull Cross Marker", 
     style       = shape.triangleup, 
     location    = location.bottom, 
     color       = cDT, 
     size        = size.small, 
     force_overlay = true
     )
plotshape(
     series      = flagDT and crossRegDT_WT_dn ? regularEMAWT : na, 
     title       = "DT/WT Bear Cross Marker", 
     style       = shape.triangledown, 
     location    = location.bottom, 
     color       = cDT, 
     size        = size.small, 
     force_overlay = true
     )
