//@version=6
indicator("Liquidity Sentiment", overlay=false)

// 1. Parameters
length_ind = input.int(8,  title="Indicator number of SMA intervals")
length_ma  = input.int(20, title="Moving average number of SMA intervals")

// 2. Volume and range from the regular-session series of the same symbol
rthTicker = ticker.modify(syminfo.tickerid, session.regular)
[rth_vol, rth_rng] = request.security(rthTicker, timeframe.period, [volume, high - low])

// 3. SMAs on every chart bar
vol_sma  = ta.sma(rth_vol, length_ind)
rng_sma  = ta.sma(rth_rng, length_ind)
safe_rng = rng_sma > 0 ? rng_sma : syminfo.mintick

liq_sentiment = -(vol_sma / safe_rng)
signal_line   = ta.sma(liq_sentiment, length_ma)

// 4. State: fast below slow = expanding liquidity (green), above = contracting (red)
is_expanding = liq_sentiment < signal_line
state_color  = is_expanding ? color.new(#00e676, 0)  : color.new(#ff5252, 0)
fill_color   = is_expanding ? color.new(#00e676, 75) : color.new(#ff5252, 75)

// 5. Rendering
plot_ind = plot(liq_sentiment, "Sentiment Line", state_color, 1)
plot_sig = plot(signal_line,   "Signal Line",    state_color, 2)
fill(plot_ind, plot_sig, fill_color, "Sentiment Fill")
